# Rust build output (root workspace and nested source workspaces)
/target/
**/target/

# Local-only project tooling and downloaded research archive
/.freebuff/
/OpenCADStudio-main.zip

# Common generated output
/dist/
/build/
**/*.log

# Local editor and operating-system files
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Local credentials; example configuration files remain trackable
.env
.env.local
.env.*.local

# Generated deployment secrets and document backups. deploy/hosted-env.example and
# deploy/gen-token.sh are trackable; the files they produce are not, because `git add -A` must
# never commit a live bearer token or a copy of somebody's document.
/deploy/studio-token.txt
/deploy/.env
/deploy/backups/

# Studio document autosave/backup sidecars created next to a `.zcad` project
*.zcad.autosave
*.zcad.backup
*.tar.gz.sha256

# Third-party upstream downloaded sources and build trees
/third_party/sources/
/third_party/build/

# Update-signing and other private key material. The public half is embedded in
# `apps/solidcraft/crates/ui-egui/src/update/install.rs`, so nothing here is needed to build.
/secrets/
*.key
