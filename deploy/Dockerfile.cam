# Atlas CAM — one machining job per container.
#
# This is a batch job, not a service. It reads a versioned job file and an STL part, writes the
# program, setup sheet (Markdown and PDF), stock preview and summary, and exits with a status; there
# is no port, no healthcheck and no queue. The contract, the exit codes and the security posture are
# in docs/operations/cam-deployment.md.
#
# Build it with deploy/build-cam-image.sh, which compiles the binary on this host and hands docker a
# three-file context. Building the workspace inside the image would put a compiler and the crate graph
# in the shipped artefact.
#
#   deploy/build-cam-image.sh --smoke   # build, post a job, refusals, non-root, teardown

FROM debian:bookworm-slim

# tini forwards SIGTERM. A CAM job installs no handler, so a cancelled job dies at once; every file
# is published by rename, so a kill never leaves a half-written program.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 atlas \
    && useradd --system --uid 10001 --gid atlas --home-dir /work --shell /usr/sbin/nologin atlas \
    && mkdir -p /work /out \
    && chown atlas:atlas /work /out

COPY atlas /usr/local/bin/atlas
COPY cam-entrypoint.sh /usr/local/bin/cam-entrypoint.sh
RUN chmod 0755 /usr/local/bin/atlas /usr/local/bin/cam-entrypoint.sh

USER atlas
WORKDIR /work

# The contract: one read-only input directory, one writable output directory. No VOLUME is declared
# on purpose: a job whose output volume is not mounted must fail (exit 2), not publish a program
# into an anonymous volume nobody will find.
ENV ATLAS_JOB=/work/job.json \
    ATLAS_OUT=/out

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/cam-entrypoint.sh"]
CMD []
