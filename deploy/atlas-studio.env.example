# /etc/atlas-studio/env — read by atlas-studio.service
#
# Keep this file root-owned and 0640 (group atlas). It holds no secret: the token lives in
# /etc/atlas-studio/token so that it can be replaced without reloading the unit.

# The host name users type. It must match the certificate the proxy presents.
ATLAS_PUBLIC_HOST=cad.example.com

# Loopback port the proxy forwards to.
ATLAS_PORT=7519
