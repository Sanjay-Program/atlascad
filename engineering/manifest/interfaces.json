      "compatibility_policy": "The contract version is a single integer. A breaking change to AgentContract or the Agent trait needs version 2 and a migration note; additive fields need a default.",
      "status": "integrated"
    },
    {
      "id": "iface.cad-agent.runtime",
      "name": "cad_agent_runtime::registry::Registry",
      "kind": "rust_crate_api",
      "provider_module": "module.cad-agent-runtime",
      "version": "1",
      "stability": "stable",
      "schema": "crates/cad-agent-runtime/src/registry.rs",
      "consumers": [
        "module.cad-agent-geometry"
      ],
      "contract_tests": [
        "lifecycle_walks_discovered_registered_ready",
        "activation_refuses_agents_whose_contract_tests_failed",
        "an_incompatible_contract_is_rejected_up_front",
        "shell_requires_an_owner_decision",
        "the_call_budget_is_enforced_from_outside",
        "invalid_input_never_reaches_the_agent",
        "a_panicking_agent_is_quarantined"
      ],
      "compatibility_policy": "The registry is a plain struct with checked transition methods. Adding a lifecycle state or a registry method is additive; removing one needs a new version and a migration note.",
      "status": "integrated"
    },
    {
      "id": "iface.cad-document.project-file",
      "name": "`.zcad` parametric project JSON",
      "kind": "json_schema",
      "provider_module": "module.cad-document",
      "version": "2",
      "stability": "draft",
      "schema": "crates/cad-document/src/lib.rs",
      "consumers": [
        "module.cad-cli",
        "module.cad-studio"
      ],
      "contract_tests": [
        "save_and_reopen_preserves_parameters_and_features",
        "a_schema_one_project_migrates_to_an_explicit_rectangle_profile",
        "a_schema_two_payload_with_flat_rectangle_fields_is_refused",
        "loading_rejects_dangling_feature_references",
        "loading_rejects_non_positive_persisted_parameters",
        "save_atomically_replaces_an_existing_project",
        "load_refuses_an_oversized_file_before_reading_it",
        "a_persisted_polygon_with_too_few_sides_is_refused"
      ],
      "compatibility_policy": "Unknown fields and newer schemas are rejected before editing or saving. Schema 1 is migrated forward to schema 2; there is no downgrade path. Any further incompatible payload change increments PROJECT_SCHEMA and needs a tested migration or explicit refusal.",
      "status": "verified"
    },
    {
      "id": "iface.cad-studio.http",
      "name": "Atlas CAD Studio local HTTP API",
      "kind": "http",
      "provider_module": "module.cad-studio",
      "version": "1",
      "stability": "draft",
      "schema": "crates/cad-studio/src/lib.rs",
      "consumers": [],
      "contract_tests": [
        "state_is_a_complete_renderable_payload",
        "parameter_edit_undo_redo_save_and_stl_export_work",
        "profile_switch_rebuilds_circle_and_polygon_geometry",
        "a_persisted_project_reopens_with_its_profile_and_history",
        "the_api_refuses_foreign_origins_media_types_and_oversized_bodies",
        "an_unknown_sketch_or_profile_is_a_clear_user_error",
        "an_empty_project_reports_nothing_to_undo"
