      "version": "2",
      "stability": "draft",
      "schema": "crates/cad-contract/src/document.rs",
      "consumers": [
        "module.cad-document"
      ],
      "contract_tests": [
        "current_header_round_trips_without_migration",
        "schema_0_file_migrates_through_two_steps",
        "schema_1_file_gets_defaulted_tolerance_and_one_migration",
        "newer_schema_is_refused_rather_than_downgraded"
      ],
      "compatibility_policy": "Migrations are forward-only and tested; a newer schema is an error, never a silent downgrade.",
      "status": "integrated"
    },
    {
