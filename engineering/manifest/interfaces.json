{
  "schema_version": 1,
  "interfaces": [
    {
      "id": "iface.cad-contract.kernel",
      "name": "cad_contract::kernel::Kernel",
      "kind": "rust_trait",
      "provider_module": "module.cad-contract",
      "version": "1",
      "stability": "stable",
      "schema": "crates/cad-contract/src/kernel.rs",
      "consumers": [
        "module.cad-agent-geometry",
        "module.cad-cli",
        "module.cad-kernel-truck",
        "module.cad-studio"
      ],
      "contract_tests": [
        "advertises_exactly_what_it_implements",
        "an_expired_deadline_returns_timeout_and_leaves_the_kernel_usable",
        "cancelling_a_running_operation_is_observed_and_the_instance_survives",
        "difference_is_refused_rather_than_returned_wrong",
        "extruded_box_has_the_exact_analytic_volume",
        "handles_from_another_kernel_are_rejected",
        "tessellation_is_a_closed_outward_manifold",
        "the_trait_path_never_reports_cancellation"
      ],
      "compatibility_policy": "Additive methods need a default implementation; removing or changing a method requires a new trait version and a migration note in docs/architecture.md section 7.",
      "status": "integrated"
    },
    {
      "id": "iface.cad-contract.mesh",
      "name": "cad_contract::mesh::Mesh",
      "kind": "rust_crate_api",
      "provider_module": "module.cad-contract",
      "version": "1",
      "stability": "stable",
      "schema": "crates/cad-contract/src/mesh.rs",
      "consumers": [
        "module.cad-kernel-truck",
        "module.cad-cli",
        "module.cad-io",
        "module.cad-studio"
      ],
      "contract_tests": [
        "tessellation_is_valid_and_closed"
      ],
      "compatibility_policy": "Plain f64/u32 arrays only; adding a field needs a schema version bump because the type is serialisable.",
      "status": "integrated"
    },
    {
      "id": "iface.cad-contract.document-header",
      "name": "cad_contract::document::DocumentHeader",
      "kind": "json_schema",
