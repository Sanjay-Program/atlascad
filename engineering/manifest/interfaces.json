        "duplicate_repository_ids_are_rejected"
      ],
      "compatibility_policy": "Every struct denies unknown fields; any incompatible shape change bumps schema_version and requires a migration in the scanner.",
      "status": "validated"
    },
    {
      "id": "iface.engineering.scan-state",
      "name": "engineering/state/scan.json (schema v1)",
      "kind": "json_schema",
