    {
      "id": "iface.cad-agent.contract",
      "name": "cad_agent_api::agent::Agent + AgentContract",
      "kind": "rust_trait",
      "provider_module": "module.cad-agent-api",
      "version": "1",
      "stability": "stable",
      "schema": "crates/cad-agent-api/src/contract.rs",
      "consumers": [
        "module.cad-agent-runtime",
        "module.cad-agent-geometry"
      ],
      "contract_tests": [
        "ids_reject_empty_overlong_and_unsafe",
        "a_foreign_contract_version_is_incompatible",
        "a_deserialised_bad_id_is_caught_by_validate",
        "grant_is_never_wider_than_the_request",
        "zero_budgets_are_a_configuration_error"
