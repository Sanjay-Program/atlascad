// Schematics copied from one PCB Studio into another bring their parts: the LoRa board's
// schematic (`eda-example power-monitor`) box-selected and copied (Ctrl+C), pasted (Ctrl+V)
// onto a new board in a second studio. Points are sheet millimetres (`flat(x, y)`, Y up).
// 01 the paste: the second studio's Components now hold the module, the headers and the
// antenna; 02 Update PCB (F8) places every footprint; 03 the board in 3D, the module's model
// on it; 04 right-click a component: Edit, Copy, Paste, Add to my library, Rename, Delete;
// 05 RA-01SH renamed LoRa: the schematic's module follows (its value too); 06 LoRa copied and
// pasted (right-click Components → Paste) as LoRa (1), and added to my library.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Custom("eda-example power-monitor"),
        WaitFor("eda-mode-bar"),
        Click(ui("eda-mode-schematic")),
        WaitFor("sch-erc"),
        Custom("eda-zoom 20 60 215 200"),
        Press(flat(25.0, 195.0)),
        Hover(flat(100.0, 120.0)),
        Hover(flat(212.0, 65.0)),
        Release,
        Key("Ctrl+C"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Click(ui("pcb-add-board")),
        WaitFor("pcb-name-edit"),
        Key("Enter"),
        WaitFor("eda-mode-bar"),
        Custom("eda-zoom 20 60 215 200"),
        MoveTo(800, 500),
        Key("Ctrl+V"),
        Click(flat(120.0, 130.0)),
        Key("Escape"),
        Custom("eda-fit"),
        WaitFor("pcb-part-ra-01sh"),
        MoveTo(1100, 900),
        Wait(2),
        Screenshot("01-pasted"),
        Click(ui("eda-mode-layout")),
        WaitFor("eda-layout-tools"),
        MoveTo(1100, 900),
        Key("F8"),
        WaitFor("eda-update-dialog"),
        Click(ui("eda-update-run")),
        Wait(2),
        Screenshot("02-update-pcb"),
        Click(ui("eda-update-close")),
        Custom("eda-fit"),
        MoveTo(1100, 900),
        Wait(2),
        Screenshot("02b-layout"),
        Custom("eda-mode 3d"),
        Wait(10),
        Screenshot("03-3d"),
        Custom("eda-mode schematic"),
        Wait(2),
        RightClick(ui("pcb-part-ra-01sh")),
        WaitFor("pcb-component-menu"),
        Screenshot("04-component-menu"),
        Click(ui("pcb-rename-component")),
        WaitFor("pcb-name-edit"),
        Key("Ctrl+A"),
        Type("LoRa"),
        Key("Enter"),
        WaitFor("pcb-part-lora"),
        Custom("eda-fit"),
        MoveTo(1100, 900),
        Wait(2),
        Screenshot("05-renamed"),
        // Copied, and pasted from the Components header's menu: a second one, numbered.
        RightClick(ui("pcb-part-lora")),
        WaitFor("pcb-component-menu"),
        Click(ui("pcb-copy-component")),
        RightClick(ui("pcb-components")),
        WaitFor("pcb-components-menu"),
        Click(ui("pcb-paste-component")),
        WaitFor("pcb-part-lora-1"),
        // Added to the user's library (the run's own folder), after which the menu leaves it out.
        RightClick(ui("pcb-part-lora")),
        WaitFor("pcb-component-menu"),
        Click(ui("pcb-add-component-to-library")),
        ExpectText("toast-message", "Added LoRa to your library as My_parts:LoRa."),
        Screenshot("06-copied-pasted-added"),
    ],
)
