// Image placement (issue #10): fixtures/logo.png dropped on Top is "Image 1", 100 × 50 mm at the
// view's centre. Double-clicking it in the feature list opens its dialog: Plane, X, Y, Width,
// Height, Keep aspect ratio, Rotation, with manipulators over the picture (outline: drag to
// move; corner squares: scale; the ring above it: turn).
// 01 The dialog and the manipulators.
// 02 The picture dragged 30 mm right, 10 mm up.
// 03 Its upper right corner dragged in: smaller, aspect kept.
// 04 Rotation 30 typed: turned about its centre.
// 05 The Front plane clicked in the feature list: the picture now stands on Front.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("view 0 90"),
        Wait(10),
        Custom("drop-file fixtures/logo.png"),
        Wait(20),
        DoubleClick(ui("feature-image-1")),
        WaitFor("image-dialog"),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("01-image-dialog-and-manipulators"),
        Drag(world(-20, 0), world(10, 10)),
        Wait(15),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("02-dragged"),
        Drag(world(80, 35), world(55, 22)),
        Wait(15),
        Hover(world(55, 22)),
        Wait(5),
        Screenshot("03-corner-scaled"),
        Click(ui("image-rotation-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Enter"),
        Wait(15),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("04-rotated"),
        Click(ui("feature-front")),
        Wait(15),
        Custom("view -30 25"),
        Wait(15),
        Screenshot("05-on-front-plane"),
        Click(ui("image-dialog-accept")),
    ],
)
