// docs/PCB_IN_PART_STUDIO.md P6: a PCB Studio board inserted straight into an assembly. The
// mains-sensor document (`board setup`): a new assembly, the Enclosure's parts inserted, then
// the board "AC sensor" from the Insert dialog's Boards tab.
// 01 the Insert dialog's Boards tab: "AC sensor" (PCB Studio 1's board designed in cadrs), its
//    thumbnail.
// 02 inserted: one rigid instance "AC sensor <1>" (the board and its components move as one),
//    as its layout has it (the layout's origin on the assembly's), the tube hidden.
// 03 J4's wire end fastened onto the Live pin's top (Fastened mate on its face's centre): the
//    board and its components move there as one.
// 04 the BOM: the enclosure's parts, then the board, its components under it (item 7
//    expanded: 7.1 …).
// 05 the board instance's menu, Edit layout ▸ In context.
// 06 the layout on the board in the assembly, the bar "Layout of AC sensor (PCB Studio 1)",
//    the Layout's tools, the parts around; under the bar what runs into the other instances,
//    the hidden tube too (the board, mated by J4 alone, crosses its wall; PS1 into the end
//    plate, the plug and a pin).
// 07 C1 (layout (13.5, 16.5), at (−0.5, 21, 9.6) after the mate) dragged 5 mm along x with
//    Snap off: its ghost there, the room around it, the instance not rebuilt yet.
// 08 let go: one undo step in PCB Studio 1, the instance rebuilt with C1 at layout (18.5, 16.5)
//    (Ctrl+Z from the assembly takes it back, Ctrl+Y again).
// 09 Done, then Edit layout ▸ In its PCB Studio: PCB Studio 1's Layout of AC sensor, C1 where
//    it was moved.
// 10 back in the assembly, the board moved into a new subassembly (Move to new subassembly):
//    the subassembly's Edit layout ▸ AC sensor in context edits it there, where it is.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("board setup"),
        Wait(10),
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Click(ui("create-assembly")),
        Wait(5),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(5),
        Click(ui("insert-studio-enclosure")),
        Wait(3),
        Click(ui("insert-dialog-accept")),
        Wait(5),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(5),
        Click(ui("insert-kind-2")),
        WaitFor("insert-board-ac-sensor"),
        Wait(5),
        Screenshot("01-boards-tab"),
        Click(ui("insert-board-ac-sensor")),
        Wait(3),
        Click(ui("insert-dialog-accept")),
        Wait(10),
        RightClick(ui("instance-row-1")),
        WaitFor("asm-hide"),
        Click(ui("asm-hide")),
        Wait(5),
        Key("F"),
        Wait(30),
        MoveTo(1420, 780),
        Screenshot("02-inserted"),
        ExpectText("instances-pane", "AC sensor <1>"),
        // J4's wire end fastened onto the Live pin's top: the board moves there (as one).
        Click(ui("mate-fastened")),
        WaitFor("mate-dialog"),
        Hover(xyz(14, 3.5, 5.6)),
        Wait(3),
        Click(xyz(14, 3.5, 5.6)),
        Hover(xyz(0, 8, 13.6)),
        Wait(3),
        Click(xyz(0, 8, 13.6)),
        Click(ui("mate-dialog-accept")),
        Wait(20),
        Key("F"),
        Wait(30),
        MoveTo(1420, 780),
        Screenshot("03-mated"),
        ExpectText("instances-pane", "Fastened 1"),
        Click(ui("panel-bom")),
        Wait(10),
        DoubleClick(ui("bom-cell-6-0")),
        Wait(10),
        Screenshot("04-bom"),
        ExpectText("bom-panel", "J4 AC Live IN"),
        Click(ui("panel-bom")),
        Wait(5),
        RightClick(ui("instance-row-7")),
        WaitFor("asm-board-edit"),
        Hover(ui("asm-board-edit")),
        WaitFor("asm-board-edit-in-context"),
        Hover(ui("asm-board-edit-in-context")),
        Wait(5),
        Screenshot("05-instance-menu"),
        Click(ui("asm-board-edit-in-context")),
        WaitFor("board-edit-bar"),
        MoveTo(1420, 780),
        Wait(10),
        Screenshot("06-in-context"),
        ExpectText("board-fit-status", "End plate <1>: PS1"),
        Custom("board check C1"),
        ExpectText("board-check", "C1 at 13.50, 16.50 top"),
        // (Snap off: an exact 5 mm.)
        Click(ui("board-fit-snap")),
        Press(xyz(-0.5, 21, 9.6)),
        Hover(xyz(2, 21, 9.6)),
        Hover(xyz(4.5, 21, 9.6)),
        Wait(5),
        Screenshot("07-dragging"),
        Release,
        Wait(20),
        MoveTo(1420, 780),
        Wait(10),
        Screenshot("08-moved"),
        Custom("board check C1"),
        ExpectText("board-check", "C1 at 18.50, 16.50 top"),
        // Undone from the assembly: C1 back; redone.
        Key("Ctrl+Z"),
        Wait(20),
        Custom("board check C1"),
        ExpectText("board-check", "C1 at 13.50, 16.50 top"),
        Key("Ctrl+Y"),
        Wait(20),
        Custom("board check C1"),
        ExpectText("board-check", "C1 at 18.50, 16.50 top"),
        Click(ui("board-edit-done")),
        Wait(10),
        RightClick(ui("instance-row-7")),
        WaitFor("asm-board-edit"),
        Hover(ui("asm-board-edit")),
        WaitFor("asm-board-edit-layout"),
        Click(ui("asm-board-edit-layout")),
        WaitFor("eda-layout-tools"),
        Wait(10),
        Screenshot("09-edit-layout"),
        // The board moved into a new subassembly: its menu edits it in context still.
        Click(ui("tab-assembly-1")),
        Wait(10),
        RightClick(ui("instance-row-7")),
        WaitFor("asm-move-to-new"),
        Click(ui("asm-move-to-new")),
        Wait(20),
        RightClick(ui("instance-row-7")),
        WaitFor("asm-board-edit"),
        Hover(ui("asm-board-edit")),
        WaitFor("asm-board-ctx-0"),
        Click(ui("asm-board-ctx-0")),
        WaitFor("board-edit-bar"),
        MoveTo(1420, 780),
        Wait(10),
        Screenshot("10-nested-in-context"),
        ExpectText("board-edit-title", "Layout of AC sensor (PCB Studio 1)"),
        Custom("board check C1"),
        ExpectText("board-check", "C1 at 18.50, 16.50 top"),
        Click(ui("board-edit-done")),
    ],
)
